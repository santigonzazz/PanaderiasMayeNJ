<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>

<body>

    <header>
        <%- include('partials/navbar') %>

    </header><br>
    <main>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 image-container">
                    <img src="../static/img/logopan.png" alt="Bakery Bread" />
                </div>
                <div class="col-md-6">
                    <h1 class="title">Inicia Sesión!!</h1>
                    <form>
                        <div class="mb-3">
                            <label for="email" class="form-label">Correo:</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Contraseña:</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <button type="submit" class="btn-login btn btn-primary" onclick="login()">Inicia Sesión</button>
                    </form>
                    <div class="mensajes mt-3">
                        <p>¿No tienes cuenta? <a href="../views/register.html" class="btn-register btn btn-link">Registrate aquí</a></p>
                        <p><a href="./recuperarclave.html" class="btn-clave btn btn-link">Olvidaste la Contraseña?</a></p>
                    </div>
                </div>
            </div>
        </div>
        <button class="btn-volverCambio btn btn-primary"><a href="../views/admin-DashBoard.html" class="btn-volverCambioLink">Admin</a></button>
    </main><br>
    <%- include('partials/footer') %>
    <script src="../static/js/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    <script>
        function login(){
        if(email.value=="admin@gmail.com" && password.value=="1234"){
            window.open('admin-DashBoard.html')
        }
    }
    </script>
</body>

</html>