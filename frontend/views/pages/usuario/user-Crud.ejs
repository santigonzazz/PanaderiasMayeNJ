<%-  include('../../partials/head') %>
<body>
    
    <%-  include('../../partials/navbar') %>

<main>
    <div class="container mt-5">
        <h1 class="title text-center">PERSONALIZACIÓN DE CUENTA DE USUARIO</h1>
        <form action="#" method="post" enctype="multipart/form-data">
            

            <div class="editUser">
                <strong>
                    <h5>Nombre</h5>
                </strong>
                <input type="text" class="form-control" value="" name="nombre">
            </div>
            <div class="editUser">
                <strong>
                    <h5>Apellido</h5>
                </strong>
                <input type="text" class="form-control" value="" name="apellido">
            </div>
            <div class="editUser">
                <strong>
                    <h5>Celular</h5>
                </strong>
                <input type="text" class="form-control" value="" name="celular" autocomplete="tel">
            </div>
            <div class="editUser">
                <strong>
                    <h5>Correo</h5>
                </strong>
                <input type="text" class="form-control" value="" name="email" readonly>
            </div>
            <div class="editUser"><button class="btn-ed">Actualizar</button></div>
        </form>

</main><br>

</body>

