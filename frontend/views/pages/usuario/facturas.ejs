<%-  include('../../partials/head') %>
<style>
    .card-factura{
        background-color: antiquewhite;
    }
</style>
<body>
    <%-  include('../../partials/navbar') %>

<main>
<div class="container py-5">   
    <h2 class="mb-4 text-center fw-bold" style="color: #212529;">Mis Facturas</h2>

    <!-- Filtro de Fecha -->
    <form method="GET" class="row g-3 align-items-center mb-5 bg-light p-3 rounded shadow-sm">
        <div class="col-auto">
            <label for="fecha" class="form-label fw-semibold" style="color: #212529;">Filtrar por fecha:</label>
        </div>
        <div class="col-auto">
            <input type="date" name="fecha" value="{{ fecha_filtro }}" class="form-control">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Filtrar</button>
        </div>
    </form>

    
        <div class="card mb-4 shadow-sm border-0 card-factura">
            <div class="card-header p-3 m-4" style="background-color: #f8d775; color: #212529;">
                <strong>Factura ID:  </strong>
            </div>
            <div class="card-body bg-light m-4">
                <p><strong>Fecha:</strong> 22del04d4i2025</p>
                <p><strong>Método de Servicio:</strong>  efectivo</p>
                <p><strong>Estado:</strong> 
      
                        <span class="badge bg-dark text-white">Pagado</span>
                 
                        <span class="badge bg-secondary">Pendiente</span>
                    
                </p>

                <h5 class="mt-4 mb-3 fw-bold">Productos Comprados:</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover bg-white ">
                        <thead style="background-color: #fdf6e3; color: #212529;">
                            <tr class="text-center">
                                <th>Producto</th>
                                <th>Precio Unitario</th>
                                <th>Cantidad</th>
                                <th>Total</th>
                            </tr>
                        </thead>  
                        <tbody class="text-center">
                             
                            <tr>
                                <td>nombre del producto    </td>
                                <td>$precio? 2</td>
                                <td>cantidad</td>
                                <td>$</td>
                            </tr>
                            
                        </tbody>
                    </table>
                </div>

                <div class="text-center mt-3">
                    <p class="fw-bold fs-5" style="color: #28a745;">Total Compra: ${{ total }}</p>
                    <a href="{% url 'exportar_factura_pdf' factura.id %}" class="btn btn-outline-dark btn-sm mt-2">Descargar PDF</a>
                </div>
            </div>
        </div>
        
        <div class="alert alert-warning text-center mt-5">
            <p>No hay facturas registradas.</p>
        </div>
    
</div>
</main>
<%-  include('../../partials/footer') %>
</body>